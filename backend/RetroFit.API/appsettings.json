{
  "ConnectionStrings": {
    "RetroFit": "Server=.;Database=RetroFit;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Jwt": {
    "Izdavac": "RetroFit",
    "Publika": "RetroFit.Klijent",
    "Kljuc": "",
    "AccessTokenMinuta": 15,
    "RefreshTokenDana": 14
  },
  "Kolacic": {
    "Naziv": "retrofit_rt",
    "Putanja": "/api/v1/autentifikacija",
    "Secure": true
  },
  "Baza": {
    "PrimeniMigracije": false,
    "DemoPodaci": false
  },
  "Pretraga": {
    "FullText": "auto"
  },
  "BotDetekcija": {
    "Rezim": "Zastita",
    "TajniKljuc": "",
    "PouzdaneIpAdrese": [],
    "PragIzazova": 50,
    "PragBlokade": 85,
    "PrivremenaBlokadaMinuta": 15,
    "PrivremenihBlokadaZaAutomatsku": 3,
    "AutomatskaBlokadaSati": 24,
    "IzazovZaRegistraciju": true,
    "TezinaIzazova": 16,
    "TrajanjeTokenaIzazovaMinuta": 30,
    "PrihvatiTlsOtisakOdProxyja": false,
    "PouzdaniProxyji": [],
    "SumnjiviTlsOtisci": [],
    "MaksRazlicitihOglasa5Min": 60,
    "IstihPorukaZaSpam": 3,
    "PrikaziProcenu": false
  },
  "PozadinskiPoslovi": {
    "Ukljuceni": true,
    "IntervalMinuta": 5
  },
  "Skladiste": {
    "Putanja": "uploads",
    "JavniPrefiks": "/uploads"
  },
  "Cors": {
    "DozvoljeniIzvori": []
  },
  "ReverseProxy": {
    "PouzdaneMreze": []
  },
  "Swagger": {
    "Ukljucen": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/retrofit-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
